# ---------------------------------------------------------------------------
# OT-Shield AI (edição portfólio) — Backend. Copie para backend/.env (NUNCA versione o .env).
# ---------------------------------------------------------------------------

# production desliga /docs e ativa HSTS.
ENV=development

# Origens do frontend autorizadas (separadas por vírgula). Ex.: https://ot-shield.vercel.app
CORS_ORIGINS=http://localhost:3000

# IA: auto | anthropic | openai | mock  (auto = Anthropic > OpenAI > Mock)
# Em um deploy PÚBLICO de portfólio, prefira "mock": o Motor Especialista Local gera o laudo sem custo de API
# e sem risco de alguém consumir seus créditos.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Limite de upload (MB)
MAX_UPLOAD_MB=10

# Rate limit por IP (por instância)
RATE_LIMIT_AUDIT_PER_MINUTE=10

# Atrás de proxy da plataforma (Render/Cloud Run): true. IP real = N-ésimo do X-Forwarded-For a partir da direita.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1
